<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ohne diese Deklaration blockiert Android (API 37+) jede Verbindung
         der App zu privaten IP-Bereichen (RFC1918) im lokalen Netz.
         Symptom war ein reiner Verbindungs-Timeout, kein TLS-/DNS-Fehler,
         und die Sperre griff unabhängig vom AppOps-Status. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".SyncApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AstrapiSync">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AstrapiSync">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Empfängt UnifiedPush-Weckrufe vom Distributor (z.B. ntfy),
             nicht exportiert. Der Distributor spricht diesen Service über
             die org.unifiedpush.android.connector.PUSH_EVENT-Action an. -->
        <service
            android:name=".sync.PushReceiverService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
