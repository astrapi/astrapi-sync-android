<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ohne diese Deklaration blockiert Android (API 37+) jede Verbindung
         der App zu privaten IP-Bereichen (RFC1918) im lokalen Netz.
         Symptom war ein reiner Verbindungs-Timeout, kein TLS-/DNS-Fehler,
         und die Sperre griff unabhängig vom AppOps-Status. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- T-340-SYNC: Rohzugriff auf das Dateisystem statt SAF-Tree-Uris,
         damit android.os.FileObserver (echtes inotify) zuverlässig
         feuert, SAF-ContentObserver hat sich auf dem Pixel 10 als
         unzuverlässig erwiesen (siehe T-339-SYNC). Keine
         Store-Richtlinien-Hürde, da Auslieferung nur über das
         F-Droid-Eigenrepo. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Ab API 33 nötig, sonst bleibt ConflictNotifications stumm,
         siehe MainActivity's Laufzeit-Anfrage beim Start. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- T-340-SYNC-Nachtest: FileWatchService läuft als Foreground-Service,
         damit FileSystemWatcher unabhängig von MainActivity.onStart()/
         onStop() weiterläuft, statt (wie zuvor) an die Activity gekoppelt
         zu sein. Letzteres brach genau dann weg, wenn eine ANDERE App
         eine Ordneränderung auslöste (Nutzer verlässt astrapi sync dafür
         fast immer). Typ dataSync, da der Service Dateien zwischen Gerät
         und Server abgleicht. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".SyncApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AstrapiSync">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AstrapiSync">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Empfängt UnifiedPush-Weckrufe vom Distributor (z.B. ntfy),
             nicht exportiert. Der Distributor spricht diesen Service über
             die org.unifiedpush.android.connector.PUSH_EVENT-Action an. -->
        <service
            android:name=".sync.PushReceiverService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- Hält FileSystemWatcher unabhängig von der sichtbaren Activity
             am Leben, siehe FileWatchService-Doc-Kommentar. -->
        <service
            android:name=".sync.FileWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
